#!/usr/bin/env bash
# Blocks the commit if gitleaks finds a secret in the staged diff.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, cannot scan staged changes." >&2
  echo "Install it (https://github.com/gitleaks/gitleaks) or bypass once with: git commit --no-verify" >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
  echo >&2
  echo "pre-commit: possible secret found in staged changes (see file/line above)." >&2
  echo "Use an env-var placeholder (e.g. \${SONAR_TOKEN}) instead of the literal value." >&2
  echo "If it is a false positive, add it to .gitleaksignore or bypass once with: git commit --no-verify" >&2
  exit 1
fi
