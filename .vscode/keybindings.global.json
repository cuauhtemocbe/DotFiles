// ============================================================================
// Este archivo solo sirve como REFERENCIA/BACKUP para replicar la config en
// otra laptop. Los atajos reales deben vivir en el archivo global de tu perfil:
//   Linux:   ~/.config/Code/User/keybindings.json
//   macOS:   ~/Library/Application Support/Code/User/keybindings.json
//   Windows: %APPDATA%\Code\User\keybindings.json
//
// Para replicar en otra laptop: copiar el array de abajo dentro del
// keybindings.json global de esa maquina.
// ============================================================================
[
      {
          "key": "ctrl+shift+t",
          "command": "-workbench.action.reopenClosedEditor"
      },
      {
          "key": "ctrl+shift+t",
          "command": "workbench.view.testing"
      },
      {
          "key": "shift+enter",
          "command": "workbench.action.terminal.sendSequence",
          "args": {
              "text": "\r"
          },
          "when": "terminalFocus"
      },
      {
          // Abre terminal nueva con el perfil "Claude Code" (definido en settings.json, ver abajo)
          "key": "ctrl+shift+1",
          "command": "workbench.action.terminal.newWithProfile",
          "args": { "profileName": "Claude Code" }
      },
      {
          // Abre terminal nueva con el perfil "JavaScript" (definido en settings.json, ver abajo)
          "key": "ctrl+shift+2",
          "command": "workbench.action.terminal.newWithProfile",
          "args": { "profileName": "JavaScript" }
      },
      {
          "key": "ctrl+m",
          "command": "workbench.action.toggleMaximizedPanel"
      }
  ]

